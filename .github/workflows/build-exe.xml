name: Build ADBConnectLDPlayerTool.exe (native C++ / MSVC)

on:
  push:
    branches: [ "main" ]
    tags: [ "v*" ]
  pull_request:
    branches: [ "main" ]
  workflow_dispatch: {}

jobs:
  build-windows:
    runs-on: windows-latest

    steps:
      - name: Checkout source
        uses: actions/checkout@v4

      # Ships vcpkg + the MSVC toolchain already set up on windows-latest runners.
      - name: Set up MSVC developer environment
        uses: ilammy/msvc-dev-cmd@v1

      - name: Bootstrap vcpkg
        run: |
          git clone https://github.com/microsoft/vcpkg.git C:\vcpkg
          C:\vcpkg\bootstrap-vcpkg.bat
        shell: cmd

      - name: Configure (CMake + vcpkg toolchain)
        run: >
          cmake -S . -B build
          -G "Visual Studio 17 2022" -A x64
          -DCMAKE_TOOLCHAIN_FILE=C:\vcpkg\scripts\buildsystems\vcpkg.cmake
        shell: cmd

      # This is the real build step: MSVC (cl.exe/link.exe) compiles every
      # .cpp in src/ straight to machine code and links a native PE .exe.
      - name: Build (Release, native MSVC compile)
        run: cmake --build build --config Release --parallel
        shell: cmd

      - name: Locate built exe
        id: locate
        run: |
          echo "path=build/Release/ADBConnectLDPlayerTool.exe" >> $env:GITHUB_OUTPUT
        shell: pwsh

      - name: Upload built exe as workflow artifact
        uses: actions/upload-artifact@v4
        with:
          name: ADBConnectLDPlayerTool-windows-x64
          path: ${{ steps.locate.outputs.path }}
          if-no-files-found: error

      # When you push a tag like "v1.0.0", this also attaches the exe to a
      # GitHub Release automatically.
      - name: Attach exe to GitHub Release
        if: startsWith(github.ref, 'refs/tags/v')
        uses: softprops/action-gh-release@v2
        with:
          files: ${{ steps.locate.outputs.path }}
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
